{
  "$schema": "https://json.schemastore.org/tsconfig",
  "extends": "./packages/javascript/assets/tsconfig.base.json",
  "compilerOptions": {
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": [
    "bin",
    "src",
    "scripts",
    "test",
    "packages/javascript",
    "packages/python/test",
    "packages/sdk",
    "packages/go"
  ],
  "exclude": ["**/node_modules"]
}
