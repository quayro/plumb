{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:plumb:adapter-protocol:v1",
  "title": "Plumb adapter protocol, version 1",
  "$defs": {
    "registry": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "adapters": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9-]*$" },
              "version": { "type": "string", "minLength": 1 },
              "files": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "format": "glob" },
                "minItems": 1,
                "uniqueItems": true
              },
              "capabilities": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9-]*$" },
                "minItems": 1,
                "uniqueItems": true
              },
              "command": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 1,
                "uniqueItems": true
              },
              "integrity": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "sha256": { "type": "string", "minLength": 1, "pattern": "^[a-f0-9]{64}$" }
                  },
                  "required": ["path", "sha256"],
                  "additionalProperties": false
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "environment": {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1,
                  "pattern": "^[A-Za-z_][A-Za-z0-9_]*$"
                },
                "minItems": 0,
                "uniqueItems": true
              },
              "inputs": {
                "type": "array",
                "items": { "type": "string", "minLength": 1, "format": "glob" },
                "minItems": 0,
                "uniqueItems": true
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": { "type": "string", "minLength": 1 },
                    "description": { "type": "string", "minLength": 1 },
                    "remedy": { "type": "string", "minLength": 1 },
                    "suppressible": { "type": "boolean" },
                    "capability": {
                      "type": "string",
                      "minLength": 1,
                      "pattern": "^[a-z][a-z0-9-]*$"
                    }
                  },
                  "required": ["id", "description", "remedy"],
                  "additionalProperties": false
                },
                "minItems": 1,
                "uniqueItems": true
              },
              "optionsSchema": { "type": "object" },
              "tools": {
                "type": "object",
                "additionalProperties": { "type": "string", "minLength": 1 }
              },
              "sandbox": { "type": "boolean" }
            },
            "required": ["id", "version", "files", "capabilities", "command", "integrity", "rules"],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": ["schemaVersion", "adapters"],
      "additionalProperties": false
    },
    "request": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "action": { "enum": ["check", "doctor"] },
        "adapter": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "root": { "type": "string", "minLength": 1 },
        "project": { "type": "object" },
        "files": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": {} },
            "required": ["path", "sha256"],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": {} },
            "required": ["path", "sha256"],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "capabilities": {
          "type": "array",
          "items": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9-]*$" },
          "minItems": 0,
          "uniqueItems": true
        }
      },
      "required": [
        "schemaVersion",
        "action",
        "adapter",
        "version",
        "root",
        "project",
        "files",
        "inputs",
        "capabilities"
      ],
      "additionalProperties": false
    },
    "response": {
      "type": "object",
      "properties": {
        "schemaVersion": { "const": 1 },
        "adapter": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9-]*$" },
        "version": { "type": "string", "minLength": 1 },
        "status": { "enum": ["pass", "violation", "incomplete"] },
        "diagnostics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "rule": { "type": "string", "minLength": 1 },
              "path": { "type": "string", "minLength": 1 },
              "message": { "type": "string", "minLength": 1 },
              "remedy": { "type": "string", "minLength": 1 },
              "status": { "enum": ["violation", "incomplete"] },
              "line": { "type": "integer", "minimum": 1 },
              "column": { "type": "integer", "minimum": 1 },
              "relatedLocations": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "line": { "type": "integer", "minimum": 1 },
                    "column": { "type": "integer", "minimum": 1 },
                    "message": { "type": "string", "minLength": 1 }
                  },
                  "required": ["path"],
                  "additionalProperties": false
                },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": ["rule", "path", "message"],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "coverage": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "capability": { "type": "string", "minLength": 1, "pattern": "^[a-z][a-z0-9-]*$" },
              "files": {
                "type": "array",
                "items": { "type": "string", "minLength": 1 },
                "minItems": 0,
                "uniqueItems": true
              }
            },
            "required": ["capability", "files"],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "inputs": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": { "path": { "type": "string", "minLength": 1 }, "sha256": {} },
            "required": ["path", "sha256"],
            "additionalProperties": false
          },
          "minItems": 0,
          "uniqueItems": true
        },
        "versions": {
          "type": "object",
          "additionalProperties": { "type": "string", "minLength": 1 }
        }
      },
      "required": [
        "schemaVersion",
        "adapter",
        "version",
        "status",
        "diagnostics",
        "coverage",
        "inputs"
      ],
      "additionalProperties": false
    }
  }
}
