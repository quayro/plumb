{
  "schemaVersion": 1,
  "preset": "ozmikhail",
  "projects": [
    {
      "root": ".",
      "profile": "typescript",
      "tsconfigs": ["tsconfig.json"],
      "knip": true
    },
    {
      "root": "packages/python",
      "profile": "python"
    },
    {
      "root": "packages/sdk",
      "profile": "python"
    },
    {
      "root": "packages/sdk",
      "profile": "rust"
    }
  ],
  "files": {
    "required": ["AGENTS.md", "README.md", "bun.lock", "docs/index.md", "plumb.schema.json"],
    "forbidden": ["**/*.mjs", "**/*.js", "**/*.cjs"],
    "names": [
      {
        "files": [
          "src/**/*.ts",
          "bin/**/*.ts",
          "scripts/**/*.ts",
          "test/**/*.ts",
          "packages/**/*.ts"
        ],
        "pattern": "^[a-z][a-z0-9-]*(?:\\.test)?\\.ts$",
        "reason": "runtime and tests are erasable TypeScript modules with consistent names"
      },
      {
        "files": ["docs/**/*.md"],
        "pattern": "^[a-z0-9][a-z0-9-]*\\.md$",
        "reason": "documentation pages use kebab-case names"
      }
    ]
  },
  "docs": {
    "index": "docs/index.md",
    "sections": [
      "getting-started",
      "guides",
      "concepts",
      "reference",
      "architecture",
      "contributing"
    ],
    "generated": [
      {
        "file": "docs/reference/cli.md",
        "region": "cli",
        "command": ["node", "bin/plumb.ts", "--help"]
      },
      {
        "file": "docs/reference/conventions.md",
        "region": "conventions",
        "command": ["node", "bin/plumb.ts", "instructions"]
      }
    ]
  },
  "comments": {
    "tasks": "^TODO\\(#\\d+\\)"
  },
  "commits": {
    "scopes": ["plumb"],
    "maxLength": 100
  },
  "hooks": {
    "command": ["node", "scripts/plumb.ts"]
  },
  "tools": {
    "versions": {
      "ruff": "0.17.4",
      "mypy": "2.4.1",
      "rustfmt": "1.10.0-stable",
      "clippy": "0.1.99"
    }
  },
  "policy": {
    "owners": ["@ozmikhail"],
    "protected": [
      "src/**",
      "bin/**",
      "scripts/**",
      "packages/javascript/**",
      "packages/python/**",
      "plumb.schema.json",
      "AGENTS.md"
    ]
  }
}
