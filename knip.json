{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["taskkill.exe"],
  "workspaces": {
    ".": {
      "entry": ["scripts/*.ts", "test/**/*.test.ts", "packages/python/test/*.test.ts"],
      "project": [
        "bin/**/*.ts",
        "src/**/*.ts",
        "scripts/**/*.ts",
        "test/**/*.ts",
        "packages/python/test/**/*.ts"
      ]
    },
    "packages/javascript": {
      "entry": ["test/*.test.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["prettier"]
    }
  }
}
