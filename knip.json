{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "ignoreBinaries": ["rustc", "taskkill.exe"],
  "workspaces": {
    ".": {
      "entry": [
        "scripts/*.ts",
        "test/**/*.test.ts",
        "packages/python/test/*.test.ts",
        "packages/sdk/adapter.ts",
        "packages/sdk/test/*.test.ts",
        "packages/rust/adapter.ts",
        "packages/rust/test/*.test.ts"
      ],
      "project": [
        "bin/**/*.ts",
        "src/**/*.ts",
        "scripts/**/*.ts",
        "test/**/*.ts",
        "packages/python/test/**/*.ts",
        "packages/sdk/**/*.ts",
        "packages/rust/**/*.ts"
      ]
    },
    "packages/javascript": {
      "entry": ["test/*.test.ts"],
      "project": ["**/*.ts"],
      "ignoreDependencies": ["prettier"]
    }
  }
}
